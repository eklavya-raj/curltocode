---
import { getCollection, render } from "astro:content";

import Converter from "../components/Converter";
import ExampleList from "../components/ExampleList.astro";
import FaqList from "../components/FaqList.astro";
import RelatedConverters from "../components/RelatedConverters.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderExamples, renderReverseExamples } from "../lib/examples.js";
import type { BreadcrumbEntry } from "../lib/structured-data.js";

export async function getStaticPaths() {
  const converters = await getCollection("converters");
  return converters.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const examples =
  data.direction === "code-to-curl"
    ? await renderReverseExamples({
        language: data.language,
        client: data.client,
      })
    : renderExamples({
        language: data.language,
        client: data.client,
      });

const all = await getCollection("converters");
const parent =
  data.parent === undefined
    ? undefined
    : all.find((candidate) => candidate.data.slug === data.parent);

const breadcrumbs: BreadcrumbEntry[] = [
  { name: "Converters", path: "/converters" },
  ...(parent === undefined
    ? []
    : [{ name: parent.data.heading, path: `/${parent.data.slug}` }]),
  {
    name: parent === undefined ? data.heading : data.clientLabel,
    path: `/${data.slug}`,
  },
];

const related = data.related
  .map((slug) => all.find((candidate) => candidate.data.slug === slug))
  .filter((candidate) => candidate !== undefined);

const featureList = [
  data.direction === "code-to-curl"
    ? `${data.languageLabel} ${data.clientLabel} to cURL`
    : `cURL to ${data.languageLabel} ${data.clientLabel}`,
  "Local, in-browser conversion",
  "Headers, cookies, authentication, and request bodies",
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogImage={`/og/${data.slug.replace("/", "-")}.png`}
  breadcrumbs={breadcrumbs}
  faqs={data.faqs}
  featureList={featureList}
>
  <div class="shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {
          breadcrumbs.map((crumb, index) => (
            <li>
              {index === breadcrumbs.length - 1 ? (
                <span aria-current="page">{crumb.name}</span>
              ) : (
                <a href={crumb.path}>{crumb.name}</a>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    <header class="hero">
      <span class="eyebrow">{data.eyebrow}</span>
      <h1>{data.heading}</h1>
      <p class="lede">{data.lede}</p>
      <p class="privacy-note">
        <span class="privacy-dot" aria-hidden="true"></span> Conversion runs in your
        browser. Nothing is uploaded.
      </p>
    </header>
    <noscript>
      <p class="noscript-note">
        The converter needs JavaScript. The example below is real output, but
        editing it requires scripts to be enabled — nothing is sent to a server
        either way.
      </p>
    </noscript>
    {
      /* `idle` rather than `load`: the island is statically rendered with a
        correct default conversion, so hydration need not block first paint. */
    }
    <Converter
      initialLanguage={data.language}
      initialClient={data.client}
      initialMode={data.direction}
      reverseStrategy="selected-target"
      client:idle
    />
  </div>

  <section class="content-section">
    <div class="shell">
      <ExampleList
        examples={examples}
        direction={data.direction}
        language={data.language}
        languageLabel={data.languageLabel}
        clientLabel={data.clientLabel}
      />
      <Content />
      <FaqList faqs={data.faqs} />
      <RelatedConverters entries={related} />
    </div>
  </section>
</BaseLayout>
