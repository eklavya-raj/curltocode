---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

const converters = await getCollection("converters");
const hubs = converters
  .filter((entry) => entry.data.parent === undefined)
  .sort((a, b) => a.data.order - b.data.order);

const clientsByParent = new Map<string, typeof converters>();
for (const entry of converters) {
  if (entry.data.parent === undefined) continue;
  const existing = clientsByParent.get(entry.data.parent) ?? [];
  clientsByParent.set(entry.data.parent, [...existing, entry]);
}

const title = "All cURL Converters – Every Language | CurlToCode";
const description =
  "Every cURL converter CurlToCode supports, from Python and JavaScript to Go, Rust, Java, C#, PHP, and Ruby. All conversion runs locally in your browser.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: "Converters", path: "/converters" }]}
  itemList={converters
    .slice()
    .sort((a, b) => a.data.order - b.data.order)
    .map((entry) => ({
      name: entry.data.heading,
      path: `/${entry.data.slug}`,
    }))}
>
  <div class="shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><span aria-current="page">Converters</span></li>
      </ol>
    </nav>
    <header class="hero">
      <span class="eyebrow">Supported targets</span>
      <h1>All cURL converters</h1>
      <p class="lede">
        {hubs.length} languages and {converters.length} conversion targets, each backed
        by a generator that is tested against the same normalized request model.
      </p>
    </header>
  </div>

  <section class="content-section">
    <div class="shell">
      <ul class="converter-index">
        {
          hubs.map((hub) => {
            const clients = (clientsByParent.get(hub.data.slug) ?? []).sort(
              (a, b) => a.data.order - b.data.order,
            );
            return (
              <li class="converter-index-item">
                <h2>
                  <a href={`/${hub.data.slug}`}>{hub.data.heading}</a>
                </h2>
                <p>{hub.data.lede}</p>
                {clients.length > 0 && (
                  <ul class="converter-client-list">
                    {clients.map((client) => (
                      <li>
                        <a href={`/${client.data.slug}`}>
                          {client.data.clientLabel}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</BaseLayout>
