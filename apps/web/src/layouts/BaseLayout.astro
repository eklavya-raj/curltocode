---
import { getCollection } from "astro:content";

import StructuredData from "../components/StructuredData.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import type { BreadcrumbEntry, FaqEntry } from "../lib/structured-data.js";
import { buildStructuredData } from "../lib/structured-data.js";
import {
  SITE_LANGUAGE,
  SITE_LOCALE,
  SITE_NAME,
  SITE_URL,
  absoluteUrl,
  canonicalPath,
} from "../lib/site.js";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  breadcrumbs?: readonly BreadcrumbEntry[];
  faqs?: readonly FaqEntry[];
  featureList?: readonly string[];
}

const {
  title,
  description,
  noindex = false,
  ogImage = "/og/default.png",
  breadcrumbs,
  faqs,
  featureList,
} = Astro.props;

// Footer navigation is derived from the collection so a new converter page is
// linked site-wide without editing the layout.
const converters = await getCollection("converters");
const hubs = converters
  .filter((entry) => entry.data.parent === undefined)
  .sort((a, b) => a.data.order - b.data.order);
const half = Math.ceil(hubs.length / 2);
const toLink = (entry: (typeof hubs)[number]) => ({
  href: `/${entry.data.slug}`,
  label: entry.data.languageLabel,
});
const footerGroups = [
  { title: "Converters", links: hubs.slice(0, half).map(toLink) },
  { title: "More languages", links: hubs.slice(half).map(toLink) },
  {
    title: "Site",
    links: [
      { href: "/", label: "Converter" },
      { href: "/converters", label: "All converters" },
      { href: "/about", label: "About" },
      { href: "/contact", label: "Contact" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy Policy" },
      { href: "/cookies", label: "Cookie Policy" },
      { href: "/terms", label: "Terms of Service" },
    ],
  },
];

const canonical = absoluteUrl(canonicalPath(Astro.url.pathname));
const ogImageUrl = absoluteUrl(ogImage);
const structuredData = buildStructuredData({
  canonical,
  title,
  description,
  breadcrumbs,
  faqs,
  featureList,
});
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="google-adsense-account" content="ca-pub-2111406329122011" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      /* Browser chrome must track the palette. These cover the system default;
        an explicit theme choice appends an overriding tag (ThemeToggle). */
    }
    <meta
      name="theme-color"
      content="#f6f7f3"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0d110e"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE_NAME}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("curltocode-theme");
          if (theme === "light" || theme === "dark")
            document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
    {!noindex && <StructuredData value={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <nav class="shell site-nav" aria-label="Main navigation">
        <a class="brand" href="/"
          ><span class="brand-mark" aria-hidden="true">&lt;/&gt;</span> CurlToCode</a
        >
        <div class="nav-actions">
          <div class="nav-links">
            <a href="/curl-to-python">Python</a>
            <a href="/curl-to-javascript">JavaScript</a>
            <a href="/curl-to-go">Go</a>
            <a href="/converters">All converters</a>
          </div>
          <ThemeToggle />
          <button
            class="nav-toggle"
            type="button"
            data-nav-toggle
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label="Open navigation menu"
          >
            <svg class="nav-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </nav>
      {
        /* Every language is listed here because the inline links do not fit a
          phone, and a header with no navigation strands mobile readers. */
      }
      <div class="site-menu" id="site-menu" data-nav-menu hidden>
        <ul class="shell site-menu-list">
          {
            hubs.map((hub) => (
              <li>
                <a href={`/${hub.data.slug}`}>{hub.data.languageLabel}</a>
              </li>
            ))
          }
          <li><a href="/converters">All converters</a></li>
        </ul>
      </div>
    </header>
    <script>
      const toggle =
        document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const menu = document.querySelector<HTMLElement>("[data-nav-menu]");

      function setOpen(open: boolean): void {
        if (toggle === null || menu === null) return;
        menu.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute(
          "aria-label",
          open ? "Close navigation menu" : "Open navigation menu",
        );
      }

      if (toggle !== null && menu !== null) {
        toggle.addEventListener("click", () => {
          setOpen(menu.hidden);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || menu.hidden) return;
          setOpen(false);
          toggle.focus();
        });
        document.addEventListener("pointerdown", (event) => {
          if (menu.hidden) return;
          const target = event.target;
          if (!(target instanceof Node)) return;
          if (menu.contains(target) || toggle.contains(target)) return;
          setOpen(false);
        });
        // The toggle is display:none above the breakpoint, so an open menu must
        // not survive a resize into the desktop layout.
        window
          .matchMedia("(min-width: 761px)")
          .addEventListener("change", (event) => {
            if (event.matches) setOpen(false);
          });
      }
    </script>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-links">
          {
            footerGroups.map((group) => (
              <div>
                <h2>{group.title}</h2>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="footer-note">
          CurlToCode parses locally. It never executes or sends the requests you
          paste.
        </p>
        <p class="footer-note footer-meta">
          <a href={SITE_URL}>{SITE_NAME}</a> · <a href="/converters"
            >All converters</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
