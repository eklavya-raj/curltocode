---
import type { GeneratorLanguage } from "curltocode";

import type { RenderedExample } from "../lib/examples.js";
import { CURL_LANGUAGE, grammarFor, highlight } from "../lib/highlight.js";

interface Props {
  examples: readonly RenderedExample[];
  language: GeneratorLanguage;
  languageLabel: string;
  clientLabel: string;
}

const { examples, language, languageLabel, clientLabel } = Astro.props;

// Highlighting happens here, at build time, so the rendered pages carry no
// syntax-highlighting JavaScript.
const grammar = grammarFor(language);
const highlighted = await Promise.all(
  examples.map(async (example) => ({
    ...example,
    curlHtml: await highlight(example.curl, CURL_LANGUAGE),
    codeHtml:
      example.code === undefined
        ? undefined
        : await highlight(example.code, grammar),
  })),
);
---

<h2>{languageLabel} {clientLabel} examples</h2>
<p>
  Every snippet below is produced by the same converter that powers this page,
  so it always matches what the tool emits today.
</p>

{
  highlighted.map((example) => (
    <div class="example-block">
      <h3 id={example.id}>{example.heading}</h3>
      <p>{example.summary}</p>
      <div class="example-pair">
        <figure>
          <figcaption>cURL</figcaption>
          <Fragment set:html={example.curlHtml} />
        </figure>
        <figure>
          <figcaption>
            {languageLabel} · {clientLabel}
          </figcaption>
          {example.codeHtml === undefined ? (
            <p class="limitation">
              <strong>Not supported:</strong> {example.limitation}
            </p>
          ) : (
            <Fragment set:html={example.codeHtml} />
          )}
        </figure>
      </div>
    </div>
  ))
}
