---
interface Props {
  variant: "header" | "menu";
}

const { variant } = Astro.props;
---

<button
  class:list={["pwa-install", `pwa-install-${variant}`]}
  type="button"
  data-pwa-install
  hidden
  aria-label="Install CurlToCode"
>
  <svg class="pwa-install-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 3v11m0 0 4-4m-4 4-4-4M5 15v4h14v-4"></path>
  </svg>
  <span>Install</span>
</button>
