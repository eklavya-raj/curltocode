<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-theme-state="system"
  aria-label="Theme: system. Change theme"
  title="Theme: System"
>
  <svg
    class="theme-icon"
    data-theme-icon="system"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="13" rx="2"></rect>
    <path d="M8 21h8M12 17v4"></path>
  </svg>
  <svg
    class="theme-icon"
    data-theme-icon="light"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
    ></path>
  </svg>
  <svg
    class="theme-icon"
    data-theme-icon="dark"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
  </svg>
</button>

<script>
  type Theme = "system" | "light" | "dark";

  const themeButton = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  function storedTheme(): Theme {
    try {
      const value = window.localStorage.getItem("curltocode-theme");
      return value === "light" || value === "dark" ? value : "system";
    } catch {
      return "system";
    }
  }

  function renderTheme(theme: Theme): void {
    if (themeButton === null) return;
    themeButton.dataset.themeState = theme;
    themeButton.setAttribute("aria-label", `Theme: ${theme}. Change theme`);
    themeButton.title = `Theme: ${theme[0]?.toUpperCase()}${theme.slice(1)}`;
  }

  function applyTheme(theme: Theme): void {
    if (theme === "system") {
      document.documentElement.removeAttribute("data-theme");
    } else {
      document.documentElement.dataset.theme = theme;
    }

    try {
      if (theme === "system") {
        window.localStorage.removeItem("curltocode-theme");
      } else {
        window.localStorage.setItem("curltocode-theme", theme);
      }
    } catch {
      // Theme persistence is optional when storage is blocked.
    }

    renderTheme(theme);
  }

  if (themeButton !== null) {
    renderTheme(storedTheme());
    themeButton.addEventListener("click", () => {
      const current = storedTheme();
      const next: Theme =
        current === "system"
          ? "light"
          : current === "light"
            ? "dark"
            : "system";
      applyTheme(next);
    });
  }
</script>
