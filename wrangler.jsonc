{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "curltocode",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": false,
  },
  "send_metrics": false,
}
